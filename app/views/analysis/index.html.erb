<% content_for :importmap_tag do %>
  <%= javascript_importmap_tags 'analysis/index' %>
<% end %>
<%= stylesheet_link_tag 'analysis' %>
<main id="analysis" class="container py-4">
  <h1>局面解析</h1>
  <p class="text-muted">PGN・FENを貼り付けて解析。計算はこのブラウザ内で行います。</p>
  <div class="analysis-layout">
    <section aria-label="盤面と操作">
      <div id="analysis-board" class="analysis-board" aria-label="チェス盤"></div>
      <p id="analysis-turn" class="mt-2"></p>
      <div class="analysis-controls">
        <button id="flip" class="btn btn-outline-secondary">盤面反転</button>
        <button id="undo" aria-keyshortcuts="ArrowLeft" title="戻る（←）" class="btn btn-outline-secondary">戻る</button>
        <button id="redo" aria-keyshortcuts="ArrowRight" title="進む（→）" class="btn btn-outline-secondary">進む</button>
        <button id="reset" class="btn btn-outline-secondary">初期局面</button>
        <button id="switch-turn" class="btn btn-outline-secondary">手番を入れ替える</button>
      </div>
      <label class="mt-3 d-block"><input id="edit" type="checkbox"> 編集モード</label>
      <div id="editor" hidden>
        <p>移動元→移動先をクリック。移動で手番反転、追加・削除では手番維持。</p>
        <label for="piece-tool">操作・追加する駒</label>
        <select id="piece-tool" class="form-select">
          <option value="move">駒を移動</option><option value="delete">駒を削除</option>
          <% { 'K' => '白キング', 'Q' => '白クイーン', 'R' => '白ルーク', 'B' => '白ビショップ', 'N' => '白ナイト', 'P' => '白ポーン', 'k' => '黒キング', 'q' => '黒クイーン', 'r' => '黒ルーク', 'b' => '黒ビショップ', 'n' => '黒ナイト', 'p' => '黒ポーン' }.each do |piece, label| %>
            <option value="<%= piece %>"><%= label %></option>
          <% end %>
        </select>
        <p class="text-muted small">自由編集ではキャスリング権・アンパッサンを解除します。駒があるマスには置き換えて配置します。</p>
      </div>
      <label for="promotion" class="mt-3">昇格先</label>
      <select id="promotion" class="form-select"><option value="q">クイーン</option><option value="r">ルーク</option><option value="b">ビショップ</option><option value="n">ナイト</option></select>
    </section>
    <section aria-label="解析結果">
      <div class="analysis-result">
        <span>評価値（白＋ / 黒−）</span><strong id="evaluation">—</strong>
        <p id="engine-status" role="status">エンジン読み込み中</p>
        <button id="pause" class="btn btn-outline-secondary">解析停止</button>
        <label for="candidate-count" class="mt-3 d-block">候補の最大表示数（1〜20）</label>
        <input id="candidate-count" class="form-control" type="number" min="1" max="20" value="3">
        <p class="small text-muted">手番側に有利な順。探索が進むと評価は変わります。</p>
        <ol id="candidates"></ol>
      </div>
      <p id="analysis-error" role="alert" class="text-danger mt-3"></p>
      <label for="position-input">PGN / FEN</label>
      <textarea id="position-input" class="form-control" rows="5" placeholder="棋譜またはFENを貼り付け"></textarea>
      <button id="load-position" class="btn btn-primary mt-2">読み込む</button>
      <p class="small text-muted mt-2">標準チェス・1対局の主変化に対応。読み込み後は「戻る」「進む」で棋譜を移動できます。</p>
      <label for="current-fen">現在のFEN</label>
      <input id="current-fen" class="form-control" readonly>
      <button id="copy-fen" class="btn btn-outline-secondary mt-2">FENをコピー</button>
    </section>
  </div>
</main>
